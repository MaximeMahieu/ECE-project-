#include <Wire.h>
#include <Adafruit_VL53L0X.h>

// --- VL53L0X Sensor ---
Adafruit_VL53L0X lox = Adafruit_VL53L0X();

// --- L298N Motor Driver Pins ---
// Motor A (Left)
#define MOTOR_A_IN1 27
#define MOTOR_A_IN2 26
#define MOTOR_A_ENA 14  // Enable pin for Motor A

// Motor B (Right)
#define MOTOR_B_IN3 25
#define MOTOR_B_IN4 33
#define MOTOR_B_ENB 32  // Enable pin for Motor B

// --- Safety Distance ---
const int CRITICAL_DISTANCE_MM = 100; // Stop at 10 cm

// --- Function Prototypes ---
void driveForward();
void stopMotors();
void driveBackward();
long readDistanceMM();

// ===================================
// SETUP
// ===================================
void setup() {
  Serial.begin(115200);
  delay(1000);

  // --- Initialize I2C for VL53L0X ---
  Wire.begin(21, 22);
  Serial.println("Initializing VL53L0X sensor...");
  if (!lox.begin()) {
    Serial.println(F("Failed to find VL53L0X sensor. Check wiring!"));
    while (1) delay(1000);
  }
  Serial.println("VL53L0X sensor initialized!");

  // --- Motor Pins Setup ---
  pinMode(MOTOR_A_IN1, OUTPUT);
  pinMode(MOTOR_A_IN2, OUTPUT);
  pinMode(MOTOR_A_ENA, OUTPUT);

  pinMode(MOTOR_B_IN3, OUTPUT);
  pinMode(MOTOR_B_IN4, OUTPUT);
  pinMode(MOTOR_B_ENB, OUTPUT);

  // Enable both motors at full power
  digitalWrite(MOTOR_A_ENA, HIGH);
  digitalWrite(MOTOR_B_ENB, HIGH);

  Serial.println("Starting both motors forward...");
  driveForward();
}

// ===================================
// LOOP
// ===================================
void loop() {
  long distance = readDistanceMM();

  if (distance > 0) {
    Serial.print("Distance: ");
    Serial.print(distance);
    Serial.println(" mm");
  }

  // --- Check for obstacle ---
  if (distance > 0 && distance < CRITICAL_DISTANCE_MM) {
    delay(50); // small debounce
    long confirmDistance = readDistanceMM();

    if (confirmDistance > 0 && confirmDistance < CRITICAL_DISTANCE_MM) {
      stopMotors();
      Serial.print("⚠️ CRITICAL DISTANCE! Motors stopped. Distance: ");
      Serial.print(confirmDistance);
      Serial.println(" mm");

      // Optionally: back up a bit
      Serial.println("Reversing for 1 second...");
      driveBackward();
      delay(1000);
      stopMotors();

      // Wait until obstacle clears
      while (true) {
        long newDist = readDistanceMM();
        if (newDist == 0 || newDist > CRITICAL_DISTANCE_MM) break;
        delay(100);
      }

      Serial.println("✅ Path clear. Moving forward again...");
      driveForward();
    }
  }

  delay(100);
}

// ===================================
// CUSTOM FUNCTIONS
// ===================================

void driveForward() {
  // Motor A forward
  digitalWrite(MOTOR_A_IN1, HIGH);
  digitalWrite(MOTOR_A_IN2, LOW);

  // Motor B forward
  digitalWrite(MOTOR_B_IN3, HIGH);
  digitalWrite(MOTOR_B_IN4, LOW);
}

void driveBackward() {
  // Motor A backward
  digitalWrite(MOTOR_A_IN1, LOW);
  digitalWrite(MOTOR_A_IN2, HIGH);

  // Motor B backward
  digitalWrite(MOTOR_B_IN3, LOW);
  digitalWrite(MOTOR_B_IN4, HIGH);
}

void stopMotors() {
  digitalWrite(MOTOR_A_IN1, LOW);
  digitalWrite(MOTOR_A_IN2, LOW);
  digitalWrite(MOTOR_B_IN3, LOW);
  digitalWrite(MOTOR_B_IN4, LOW);
}

long readDistanceMM() {
  VL53L0X_RangingMeasurementData_t measure;
  lox.rangingTest(&measure, false);

  if (measure.RangeStatus != 4) { // valid reading
    return measure.RangeMilliMeter;
  } else {
    return 0;
  }
}
